<?xml version="1.0"?>
<ruleset name="DestinX AI Commerce for WooCommerce">
  <description>WordPress and PHP compatibility checks for the plugin.</description>

  <file>destinx-ai-commerce.php</file>
  <file>includes</file>

  <exclude-pattern>vendor/*</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>

  <config name="testVersion" value="7.4-"/>

  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress">
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="destinx-ai-commerce"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="dxaic"/>
        <element value="DXAIC"/>
        <element value="DestinX"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_woocommerce"/>
      </property>
    </properties>
  </rule>
</ruleset>
